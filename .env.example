# DO NOT enable without real verified products, amounts and delivery policy.
VEDIKA_CHECKOUT_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Prices in paise; these are NOT set until client verifies their actual catalog
VEDIKA_VERIFIED_PRICES_PAISE={}
# Set delivery fee in paise, including 0 only if free delivery is confirmed
VEDIKA_DELIVERY_CHARGE_PAISE=

# WhatsApp Business: verified full international digits only, e.g. 91 + 10-digit Indian number.
# WhatsApp contact supplied by website owner: +91 9301554348. Confirm this number is on WhatsApp before launch.
NEXT_PUBLIC_VEDIKA_WHATSAPP_NUMBER=919301554348

# Optional real AI shopping chat (server-side only). When absent, the UI is a clearly labelled guided shopping helper.
OPENAI_API_KEY=
VEDIKA_AI_MODEL=gpt-4o-mini

# AI-powered room analysis + concept image edits (server only)
VEDIKA_VISION_MODEL=gpt-4.1-mini
VEDIKA_IMAGE_MODEL=gpt-image-1

# Real order database (server-only service role key). Run database/vedika-orders.sql before enabling checkout.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Razorpay webhook secret for payment.captured notifications
RAZORPAY_WEBHOOK_SECRET=
